#!/bin/bash
# Service: Nakama with the game server modules, run as snap_daemon.
. "$SNAP/bin/common.sh"

if [ "$(role)" = "database" ]; then
  log "This node only runs the database (role=database)."
  exit 0
fi

ensure_secrets

if uses_bundled_db; then
  # Normally done already by db-setup; cheap to confirm, and it covers a
  # PostgreSQL that took longer than db-setup waited.
  ensure_nakama_db
fi

daemon_dir "$SNAP_COMMON/nakama" 0700
mkdir -p "$NAKAMA_DIR"
chmod 0755 "$NAKAMA_DIR"

{
  echo "# Generated by the snap on every start from snap config and secrets."
  echo "name: $(yq "$(cfg node-name game-server)")"
  echo "data_dir: $(yq "$SNAP_COMMON/nakama")"
  echo "logger:"
  echo "  level: $(yq "$(cfg log-level info)")"
  echo "database:"
  echo "  address:"
  echo "    - $(yq "$(nakama_db_url)")"
  echo "session:"
  echo "  encryption_key: $(yq "$(secret_get session-encryption-key)")"
  echo "  refresh_encryption_key: $(yq "$(secret_get session-refresh-encryption-key)")"
  echo "socket:"
  echo "  server_key: $(yq "$(cfg server-key defaultkey)")"
  echo "  address: $(yq "$(api_address)")"
  echo "  port: $(cfg api.port 7350)"
  echo "console:"
  echo "  address: $(yq "$(cfg console.address 127.0.0.1)")"
  echo "  port: $(cfg console.port 7351)"
  echo "  username: \"operator\""
  echo "  password: $(yq "$(secret_get console-password)")"
  echo "  signing_key: $(yq "$(secret_get console-signing-key)")"
  echo "runtime:"
  echo "  path: $(yq "$(modules_path)")"
  echo "  http_key: $(yq "$(secret_get runtime-http-key)")"
  echo "  env:"
  echo "    - \"SERVER_ROLE=$(role)\""
  runtime_env | while IFS= read -r line; do
    if [ -n "$line" ]; then
      echo "    - $(yq "$line")"
    fi
  done
  echo "metrics:"
  echo "  prometheus_port: $(cfg metrics.port 0)"
} | write_for_daemon "$NAKAMA_DIR/config.yml"

export HOME="$SNAP_COMMON/nakama"
exec setpriv --clear-groups --reuid "$DAEMON_UID" --regid "$DAEMON_UID" -- "$SNAP/bin/nakama-run"
