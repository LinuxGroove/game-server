#!/bin/bash
# Store secrets outside snap config, which any local user can read.
#   echo -n 'postgres://...' | sudo linuxgroove-game-server.secret set database-url
#   echo -n '<key>' | sudo linuxgroove-game-server.secret set s3-secret-access-key
#   sudo linuxgroove-game-server.secret unset database-url
. "$SNAP/bin/common.sh"

usage() {
  echo "usage: secret set|unset database-url|s3-secret-access-key  (value on stdin)" >&2
  exit 2
}
action="${1:-}"
name="${2:-}"
case "$name" in
  database-url | s3-secret-access-key) ;;
  *) usage ;;
esac
case "$action" in
  set)
    value="$(cat)"
    value="${value%$'\n'}"
    if [ -z "$value" ]; then
      echo "No value on stdin." >&2
      exit 2
    fi
    secret_set "$name" "$value"
    ;;
  unset)
    rm -f "$(secret_path "$name")"
    ;;
  *) usage ;;
esac
echo "Saved. Restart to apply: sudo snap restart $SNAP_INSTANCE_NAME"
