#!/bin/bash
# Runs as snap_daemon (started by launch-postgres, after initdb). Refreshes
# access rules, then runs PostgreSQL in the foreground so snapd supervises it.
set -euo pipefail

# No Unix sockets: everything connects over TCP with passwords.
{
  echo "# Generated by the snap on every start. Change it with snap set postgres.allowed-cidrs."
  echo "host all all 127.0.0.1/32 scram-sha-256"
  echo "host all all ::1/128 scram-sha-256"
  IFS=',' read -ra cidrs <<<"${PG_ALLOWED_CIDRS:-}"
  for cidr in "${cidrs[@]}"; do
    cidr="$(echo "$cidr" | tr -d ' ')"
    if [ -n "$cidr" ]; then
      echo "host nakama nakama $cidr scram-sha-256"
    fi
  done
} >"$PGDATA/pg_hba.conf"

exec "$PG_BIN/postgres" -D "$PGDATA" \
  -c listen_addresses="$PG_LISTEN" \
  -c port="$PG_PORT" \
  -c unix_socket_directories='' \
  -c dynamic_shared_memory_type=sysv \
  -c shared_buffers="$PG_SHARED_BUFFERS" \
  -c effective_cache_size="$PG_EFFECTIVE_CACHE" \
  -c max_connections="$PG_MAX_CONNECTIONS" \
  -c password_encryption=scram-sha-256 \
  -c jit=off \
  -c wal_level=replica \
  -c logging_collector=off \
  -c log_destination=stderr \
  -c log_line_prefix='%m [%p] %q%u@%d ' \
  -c log_min_duration_statement=1000
