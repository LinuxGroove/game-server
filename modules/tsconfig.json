{
  "compilerOptions": {
    // Nakama runs one plain script (goja), so compile to a single ES5 file
    // with no module system. Every top-level function is a global.
    "target": "es5",
    "lib": ["es2017"],
    "outFile": "./build/index.js",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "removeComments": false,
    "typeRoots": ["./types"],
    "types": ["nakama-runtime"]
  },
  // Order matters: helpers first, games before the game index, main last.
  "files": [
    "./src/core/util.ts",
    "./src/core/registry.ts",
    "./src/core/ratelimit.ts",
    "./src/core/telemetry.ts",
    "./src/core/sha256.ts",
    "./src/core/sha1.ts",
    "./src/core/s3.ts",
    "./src/core/auth.ts",
    "./src/core/guards.ts",
    "./src/core/leaderboards.ts",
    "./src/core/blobs.ts",
    "./src/core/shares.ts",
    "./src/core/relay.ts",
    "./src/core/bridge.ts",
    "./src/core/rooms.ts",
    "./src/core/account.ts",
    "./src/core/config.ts",
    "./src/games/graveyard-hollow.ts",
    "./src/games/foam-frenzy.ts",
    "./src/games/sandbox.ts",
    "./src/games/index.ts",
    "./src/main.ts"
  ]
}
