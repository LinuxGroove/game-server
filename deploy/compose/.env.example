# Copy to .env next to compose.yaml and replace every value before exposing
# the server. Generate keys with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
SERVER_KEY=defaultkey
SESSION_ENCRYPTION_KEY=change-me
SESSION_REFRESH_ENCRYPTION_KEY=change-me
CONSOLE_PASSWORD=change-me
CONSOLE_SIGNING_KEY=change-me
RUNTIME_HTTP_KEY=change-me
GAME_SANDBOX_ENABLED=false
# 0.0.0.0 to accept players from other machines (without the https profile).
API_BIND=127.0.0.1
DOMAIN=api.example.org
