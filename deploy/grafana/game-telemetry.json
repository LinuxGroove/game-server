{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "LinuxGroove game telemetry",
  "uid": "linuxgroove-games",
  "tags": [
    "linuxgroove",
    "nakama"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "description": "Per-game players (everyone who launches, and those who sign in), retention, rooms and feature use from the game server's custom Nakama metrics (docs/operations.md#monitoring).",
  "templating": {
    "list": [
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(nakama_custom_active_players, game)",
          "refId": "game"
        },
        "definition": "label_values(nakama_custom_active_players, game)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Everyone who plays",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total players",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (nakama_custom_installs{game=~\"$game\"})",
          "legendFormat": "{{game}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "Every install that has sent a launch ping, per game, read from the database when the server starts. One person on two devices counts twice."
    },
    {
      "type": "timeseries",
      "title": "Daily players",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_launch_players{game=~\"$game\"}[1d]))",
          "legendFormat": "{{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Installs that started the game at least once that UTC day with the internet on, signed in or not. Players who set DO_NOT_TRACK or play offline aren't counted."
    },
    {
      "type": "timeseries",
      "title": "New players per day",
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_new_installs{game=~\"$game\"}[1d]))",
          "legendFormat": "{{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Installs that started the game for the first time that UTC day."
    },
    {
      "type": "timeseries",
      "title": "Retention (everyone)",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_installs{game=~\"$game\",day=\"d1\"}[1d])) / sum by (game) (increase(nakama_custom_new_installs{game=~\"$game\"}[1d] offset 1d))",
          "legendFormat": "d1 {{game}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_installs{game=~\"$game\",day=\"d7\"}[1d])) / sum by (game) (increase(nakama_custom_new_installs{game=~\"$game\"}[1d] offset 7d))",
          "legendFormat": "d7 {{game}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_installs{game=~\"$game\",day=\"d30\"}[1d])) / sum by (game) (increase(nakama_custom_new_installs{game=~\"$game\"}[1d] offset 30d))",
          "legendFormat": "d30 {{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Share of a day's new installs that started the game again exactly 1, 7 or 30 days later."
    },
    {
      "type": "piechart",
      "title": "Players by system",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (os, arch) (increase(nakama_custom_launch_systems{game=~\"$game\"}[$__range]))",
          "legendFormat": "{{os}} {{arch}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut"
      },
      "description": "Player days by OS and CPU over the dashboard's time range. Every snap reports ubuntu_core (its base), whatever the computer runs."
    },
    {
      "type": "timeseries",
      "title": "Launches by version",
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game, version) (increase(nakama_custom_launches{game=~\"$game\"}[$__interval]))",
          "legendFormat": "{{game}} {{version}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Every launch ping, by game version."
    },
    {
      "type": "table",
      "title": "Systems and versions launched (last 7 days)",
      "id": 27,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(sum by (game, version, os, os_version, arch) (increase(nakama_custom_launches{game=~\"$game\"}[7d])) > 0)",
          "format": "table",
          "range": false,
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "game": "Game",
              "version": "Version",
              "os": "OS",
              "os_version": "OS version",
              "arch": "CPU",
              "Value": "Launches"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Launches",
            "desc": true
          }
        ]
      },
      "description": "Launches this week by game version, OS and CPU, like Ubuntu 24.04 arm64 2026.41.1. Windows versions show as 10 or 11 and macOS as its major version. Underscores replace dots and + because Nakama's metrics exporter rewrites label values."
    },
    {
      "type": "row",
      "title": "Signed-in players",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Daily signed-in players",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_active_players{game=~\"$game\"}[1d]))",
          "legendFormat": "{{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Players who logged in at least once that UTC day, per game."
    },
    {
      "type": "timeseries",
      "title": "New players per day",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_new_players{game=~\"$game\"}[1d]))",
          "legendFormat": "{{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Players logging in to a game for the first time."
    },
    {
      "type": "timeseries",
      "title": "Retention",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_players{game=~\"$game\",day=\"d1\"}[1d])) / sum by (game) (increase(nakama_custom_new_players{game=~\"$game\"}[1d] offset 1d))",
          "legendFormat": "d1 {{game}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_players{game=~\"$game\",day=\"d7\"}[1d])) / sum by (game) (increase(nakama_custom_new_players{game=~\"$game\"}[1d] offset 7d))",
          "legendFormat": "d7 {{game}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_returning_players{game=~\"$game\",day=\"d30\"}[1d])) / sum by (game) (increase(nakama_custom_new_players{game=~\"$game\"}[1d] offset 30d))",
          "legendFormat": "d30 {{game}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1d",
      "description": "Share of each day's new players who came back exactly 1, 7 or 30 days later. Noisy until there are tens of new players a day."
    },
    {
      "type": "timeseries",
      "title": "Logins by version",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game, version) (increase(nakama_custom_logins{game=~\"$game\"}[$__interval]))",
          "legendFormat": "{{game}} {{version}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h",
      "description": "Versions show with underscores (2026_41_0_3_g1a2b3c4d): Nakama's metrics exporter rewrites label values. The table below lists them."
    },
    {
      "type": "piechart",
      "title": "Logins by platform",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (platform) (increase(nakama_custom_logins{game=~\"$game\"}[$__range]))",
          "legendFormat": "{{platform}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "type": "timeseries",
      "title": "Rejected logins",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game, reason) (increase(nakama_custom_logins_rejected[$__interval]))",
          "legendFormat": "{{game}} {{reason}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h",
      "description": "update_required spikes after raising a game's min-version; unknown_game means a client asks for a game this server doesn't run."
    },
    {
      "type": "table",
      "title": "Versions played (last 7 days)",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sort_desc(sum by (game, version) (increase(nakama_custom_logins{game=~\"$game\"}[7d])) > 0)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "game": "Game",
              "version": "Version",
              "Value": "Logins"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Logins",
            "desc": true
          }
        ]
      },
      "description": "Every version that signed in this week. Releases are YYYY.WW.MINOR (2026_41_0); edge builds add the commits since that release and the commit (2026_41_0_3_g1a2b3c4d). Underscores replace dots and + because Nakama's metrics exporter rewrites label values. A server keeps the first 64 versions per game since it started; later ones count as other."
    },
    {
      "type": "row",
      "title": "Online play",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Players online now",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(nakama_sessions)",
          "legendFormat": "sockets",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(nakama_authoritative_matches)",
          "legendFormat": "relay rooms",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Open realtime sockets and server-run rooms, all games. Appears after the first socket connects."
    },
    {
      "type": "timeseries",
      "title": "Rooms opened",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 51
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game, transport, source) (increase(nakama_custom_rooms_opened{game=~\"$game\"}[$__interval]))",
          "legendFormat": "{{game}} {{transport}}/{{source}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (game) (increase(nakama_custom_matchmaker_matches{game=~\"$game\"}[$__interval]))",
          "legendFormat": "{{game}} matchmaker matches",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h"
    },
    {
      "type": "timeseries",
      "title": "Rounds played",
